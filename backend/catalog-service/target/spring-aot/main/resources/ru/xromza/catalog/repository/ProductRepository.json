    {
      "name": "countProductsByCategoryId",
      "signature": "public abstract java.lang.Long ru.xromza.catalog.repository.ProductRepository.countProductsByCategoryId(java.lang.Long)",
      "query": {
        "query": "SELECT COUNT(p) FROM Product p WHERE p.category.id = :id"
      }
    },
    {
      "name": "findAllActiveByIdCategoryId",
      "signature": "public abstract org.springframework.data.domain.Page<ru.xromza.catalog.model.Product> ru.xromza.catalog.repository.ProductRepository.findAllActiveByIdCategoryId(java.lang.Long,org.springframework.data.domain.Pageable)",
      "query": {
        "query": "SELECT p FROM Product p WHERE p.isActive = true AND p.category.id = :categoryId",
        "count-query": "SELECT count(p) FROM Product p WHERE p.isActive = true AND p.category.id = :categoryId"
      }
    },
    {
      "name": "findAllActiveByIdCategoryIdVerbose",
      "signature": "public abstract org.springframework.data.domain.Page<ru.xromza.catalog.model.Product> ru.xromza.catalog.repository.ProductRepository.findAllActiveByIdCategoryIdVerbose(java.lang.Long,org.springframework.data.domain.Pageable)",
      "query": {
        "query": "SELECT p FROM Product p WHERE p.isActive = true AND p.category.id = :categoryId",
        "count-query": "SELECT count(p) FROM Product p WHERE p.isActive = true AND p.category.id = :categoryId"
      }
    },
    {
      "name": "findAllActiveWithVariants",
      "signature": "public abstract org.springframework.data.domain.Page<ru.xromza.catalog.model.Product> ru.xromza.catalog.repository.ProductRepository.findAllActiveWithVariants(org.springframework.data.domain.Pageable)",
      "query": {
        "query": "SELECT DISTINCT p FROM Product p LEFT JOIN p.variants WHERE p.isActive = true",
        "count-query": "SELECT count(DISTINCT p) FROM Product p LEFT JOIN p.variants WHERE p.isActive = true"
      }
    },
    {
      "name": "findAllByIds",
      "signature": "public abstract java.util.List<ru.xromza.catalog.model.Product> ru.xromza.catalog.repository.ProductRepository.findAllByIds(java.util.List<java.lang.Long>)",
      "query": {
        "query": "SELECT DISCTINT p FROM Product p JOIN FETCH p.category LEFT JOIN FETCH p.variants v LEFT JOIN FETCH v.images WHERE p.id IN :ids"
      }
    },
    {
      "name": "findAllMinimalByIsActiveTrue",
      "signature": "public abstract java.util.List<ru.xromza.catalog.model.Product> ru.xromza.catalog.repository.ProductRepository.findAllMinimalByIsActiveTrue(org.springframework.data.domain.Pageable)",
      "query": {
        "query": "SELECT p FROM Product p WHERE p.isActive = TRUE"
      }
    },
    {
      "name": "findByIdWithVariants",
      "signature": "public abstract java.util.Optional<ru.xromza.catalog.model.Product> ru.xromza.catalog.repository.ProductRepository.findByIdWithVariants(java.lang.Long)",
      "query": {
        "query": "SELECT p FROM Product p LEFT JOIN FETCH p.variants WHERE p.id = :id"
      }
    },
    {
      "name": "findByIdWithVariantsAndImages",
      "signature": "public abstract java.util.Optional<ru.xromza.catalog.model.Product> ru.xromza.catalog.repository.ProductRepository.findByIdWithVariantsAndImages(java.lang.Long)",
      "query": {
        "query": "SELECT DISTINCT p FROM Product p LEFT JOIN FETCH p.variants v LEFT JOIN FETCH v.images WHERE p.id = :id"
      }
    },
    {
      "name": "findByTitleContainingIgnoreCase",
      "signature": "public abstract org.springframework.data.domain.Page<ru.xromza.catalog.model.Product> ru.xromza.catalog.repository.ProductRepository.findByTitleContainingIgnoreCase(java.lang.String,org.springframework.data.domain.Pageable)",
      "query": {
        "query": "SELECT p FROM Product p WHERE UPPER(p.title) LIKE UPPER(:title) ESCAPE '\\'",
        "count-query": "SELECT COUNT(p) FROM Product p WHERE UPPER(p.title) LIKE UPPER(:title) ESCAPE '\\'"
      }
    },
    {
      "name": "findByTitleContainingIgnoreCaseAndIsActiveTrue",
      "signature": "public abstract org.springframework.data.domain.Page<ru.xromza.catalog.model.Product> ru.xromza.catalog.repository.ProductRepository.findByTitleContainingIgnoreCaseAndIsActiveTrue(java.lang.String,org.springframework.data.domain.Pageable)",
      "query": {
        "query": "SELECT p FROM Product p WHERE UPPER(p.title) LIKE UPPER(:title) ESCAPE '\\' AND p.isActive = TRUE",
        "count-query": "SELECT COUNT(p) FROM Product p WHERE UPPER(p.title) LIKE UPPER(:title) ESCAPE '\\' AND p.isActive = TRUE"
      }
