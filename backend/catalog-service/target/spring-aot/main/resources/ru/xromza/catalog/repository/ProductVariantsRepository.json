      "name": "findAllVariantsByIds",
      "signature": "public abstract java.util.List<ru.xromza.catalog.model.ProductVariant> ru.xromza.catalog.repository.ProductVariantsRepository.findAllVariantsByIds(java.util.List<java.lang.Long>)",
      "query": {
        "query": "SELECT pv FROM ProductVariant pv WHERE pv.id IN :ids"
      }
    },
    {
      "name": "findByIdWithImages",
      "signature": "public abstract java.util.Optional<ru.xromza.catalog.model.ProductVariant> ru.xromza.catalog.repository.ProductVariantsRepository.findByIdWithImages(java.lang.Long,java.lang.Long)",
      "query": {
        "query": "SELECT DISTINCT pv FROM ProductVariant pv LEFT JOIN FETCH pv.images WHERE pv.id = :id AND pv.product.id = :productId"
      }
    },
    {
